{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "youtube-music-party-backend-e2e",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": false
  },
  "vars": {
    "HOST_RECONNECT_GRACE_MS": "250",
    "MAX_PARTICIPANTS": "2",
    "MAX_QUEUE_ITEMS": "3",
    "ROOM_MAX_AGE_MS": "30000",
    "ROOM_IDLE_TTL_MS": "2000",
    "INVITE_TTL_SECONDS": "60"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PARTY_ROOMS",
        "class_name": "PartyRoom"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "INVITES",
      "id": "e2e-kv",
      "preview_id": "e2e-kv"
    }
  ],
  "ratelimits": [
    { "name": "CREATE_ROOM_RATE_LIMITER", "namespace_id": "19370201", "simple": { "limit": 10, "period": 60 } },
    { "name": "JOIN_ROOM_RATE_LIMITER", "namespace_id": "19370202", "simple": { "limit": 30, "period": 60 } },
    { "name": "API_RATE_LIMITER", "namespace_id": "19370203", "simple": { "limit": 60, "period": 60 } }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PartyRoom"]
    }
  ]
}
