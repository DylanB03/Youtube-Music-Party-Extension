{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "youtube-music-party-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PARTY_ROOMS",
        "class_name": "PartyRoom"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "INVITES",
      "id": "3eafc67874fd4b2d938823b1f106dc37",
      "preview_id": "9922c5d5ace54a5b8fa72370f2a74a7d"
    }
  ],
  "ratelimits": [
    { "name": "CREATE_ROOM_RATE_LIMITER", "namespace_id": "19370101", "simple": { "limit": 10, "period": 60 } },
    { "name": "JOIN_ROOM_RATE_LIMITER", "namespace_id": "19370102", "simple": { "limit": 30, "period": 60 } },
    { "name": "API_RATE_LIMITER", "namespace_id": "19370103", "simple": { "limit": 60, "period": 60 } }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PartyRoom"]
    }
  ]
}
