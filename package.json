{
  "name": "youtube-music-party",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "test:browser": "WXT_ALLOW_INSECURE_API=true WXT_PUBLIC_PARTY_API_BASE_URL=http://127.0.0.1:8797 npm run build:extension && playwright test",
    "dev:backend": "npm --workspace apps/backend run dev",
    "dev:backend:e2e": "npm --workspace apps/backend run dev:e2e",
    "dev:extension": "npm --workspace apps/extension run dev",
    "build:backend": "npm --workspace apps/backend run build",
    "build:extension": "npm --workspace apps/extension run build",
    "capture:store-screenshots": "node scripts/capture-store-screenshots.mjs",
    "verify:extension": "node scripts/verify-extension-package.mjs",
    "release:extension": "npm --workspace apps/extension run zip"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.2",
    "sharp": "^0.34.5",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
